# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development
MIGRATIONS_ENABLED=false
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
REFRESH_TOKEN_KEY=replace-with-a-different-random-key-at-least-32-characters
JWT_TTL=28800

# Database Configuration
DB_DRIVER=mysql
DB_HOST=
DB_PORT=25060
DB_USER=
DB_PASSWORD=
DB_NAME=defaultdb
DB_CHARSET=utf8mb4
DB_PREFIX=
DB_SSL_CA=
